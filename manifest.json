{
  "manifest_version": 3,
  "name": "IonFlux",
  "version": "1.2",
  "description": "Live weather interface.",
  "icons": {
    "16": "assets/img/icon16.png",
    "48": "assets/img/icon48.png",
    "128": "assets/img/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/img/icon16.png",
      "48": "assets/img/icon48.png",
      "128": "assets/img/icon128.png"
    }
  },
  "host_permissions": [
    "https://*.vercel.app/*",
    "http://localhost:3000/*"
  ]
}